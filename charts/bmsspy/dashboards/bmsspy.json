      "id": 1,
      "type": "timeseries",
      "title": "Power",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "bms_pack_power_watts{namespace=\"$namespace\", job=\"$job\"}",
          "legendFormat": "Power",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "bms_pack_state_of_charge_ratio{namespace=\"$namespace\", job=\"$job\"}",
          "legendFormat": "SoC",
          "refId": "B"
